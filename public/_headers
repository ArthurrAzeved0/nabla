# Cabeçalhos HTTP. Formato lido pelo Cloudflare Pages (e pela Netlify).
# O GitHub Pages IGNORA este arquivo — por isso o humans.txt também carrega
# um BOM UTF-8, que faz o navegador detectar o encoding sem depender daqui.

/humans.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Os assets com hash no nome podem ser guardados para sempre: quando o
# conteúdo muda, o nome muda.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
