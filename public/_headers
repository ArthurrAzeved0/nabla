# Cabeçalhos HTTP, no formato que o Cloudflare Pages lê.
#
# O humans.txt também carrega um BOM UTF-8. É redundante com o charset
# declarado abaixo, e de propósito: se este arquivo deixar de ser lido, os
# acentos continuam certos em vez de virarem "Ã§Ã£o".

/humans.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# O tipo do manifesto não é adivinhado por todo servidor, e sem ele o
# navegador ignora o arquivo em silêncio.
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600

# Os assets com hash no nome podem ser guardados para sempre: quando o
# conteúdo muda, o nome muda.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
