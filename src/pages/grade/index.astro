/* Índice dos mapas de grade. Existe desde que passou de um curso: até então
   a aba "Grade" no topo apontava direto para Civil, e com dois cursos esse
   atalho passaria a esconder um deles.

   Agrupado POR CURSO, e não uma lista solta de matrizes, porque um curso tem
   mais de um perfil em vigor ao mesmo tempo: Automação tem a de 2021 e a de
   2010, Civil tem a de 2021 e a de 2011. Numa lista solta o nome do curso
   aparecia duas vezes e a matriz, que é a única diferença entre os dois
   cartões, ficava sendo a última coisa que se lia.

   Curso novo continua não exigindo código: é só mais um YAML. */
import { getCollection } from "astro:content";
import Base from "~/layouts/Base.astro";
import Regua from "~/components/Regua.astro";

const base = import.meta.env.BASE_URL;
const cadeiras = await getCollection("cadeiras");
const comPagina = new Set(cadeiras.map((c) => c.data.id));

const matrizes = (await getCollection("grade"))
  .map((g) => {
    const d = g.data.disciplinas;
    return {
      ...g.data,
      quantas: d.length,
      chMatriz: d.reduce((s, x) => s + x.teorica + x.pratica, 0),
      arestas: d.reduce((s, x) => s + x.pre.length + x.co.length, 0),
      ligadas: d.filter((x) => {
        const id = typeof x.cadeira === "string" ? x.cadeira : x.cadeira?.id;
        return id && comPagina.has(id);
      }).length,
    };
  })
  /* matriz mais nova primeiro dentro de cada curso */
  .sort((a, b) => b.matriz.localeCompare(a.matriz));

/* Um bloco por curso, em ordem alfabética. A primeira matriz de cada bloco é
   a mais nova — é dela que sai o rótulo "atual". */
const cursos = [...new Set(matrizes.map((m) => m.curso))]
  .sort((a, b) => a.localeCompare(b, "pt-BR"))
  .map((curso) => ({ curso, matrizes: matrizes.filter((m) => m.curso === curso) }));

const total = matrizes.length;
---

<Base
  largura="ampla"
  titulo="Mapas da grade"
  descricao="Mapas de pré-requisitos das grades da POLI/UPE: marque o que já concluiu e veja o que está liberado."
>
  <span class="rotulo">POLI/UPE</span>
  <h1>Mapas da grade</h1>
  <p class="prosa abre">
    O mapa de pré-requisitos de cada curso, montado a partir do projeto pedagógico. Marque o que
    você já concluiu e veja o que está liberado para o próximo período — o progresso fica salvo no
    seu navegador, e cada mapa sai em PDF.
    {
      total > cursos.length && (
        <>
          {" "}
          Onde há mais de uma matriz, a <strong>atual</strong> vale para quem entrou por último e a{" "}
          <strong>anterior</strong> continua valendo para os veteranos.
        </>
      )
    }
  </p>

  <Regua rotulo={cursos.length > 1 ? "cursos" : "curso"} />

  {
    cursos.map(({ curso, matrizes: ms }) => (
      <section class="curso">
        <h2>{curso}</h2>
        <div class="cartoes">
          {ms.map((m, i) => (
            <a class="card" href={`${base}grade/${m.sigla}/`}>
              <span class="cod">
                {/* o selo só informa quando há com o que comparar */}
                {ms.length > 1 && <i class:list={["selo", i === 0 && "atual"]}>{i === 0 ? "atual" : "anterior"}</i>}
                matriz {m.matriz}
              </span>
              <h3>
                {m.quantas} disciplinas<span>{m.arestas} requisitos</span>
              </h3>
              <p>
                {m.chMatriz === m.chTotalCurso
                  ? `${m.chMatriz}h no total`
                  : `${m.chMatriz}h de um curso de ${m.chTotalCurso}h`}
                .{m.ligadas > 0 && ` ${m.ligadas} com teoria e questões aqui no site.`}
              </p>
              <span class="conta">Ver o mapa<em>→</em></span>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</Base>

<style>
  .abre {
    font-size: var(--t-md);
  }
  /* o cabeçalho acompanha a largura da página; o texto para em 68ch, como
     na página do mapa */
  h1 {
    max-width: var(--largura-texto);
  }

  .curso + .curso {
    margin-top: var(--e-7);
  }
  .curso h2 {
    font-size: var(--t-lg);
    margin: 0 0 var(--e-3);
  }

  /* `auto-fill`, e não `auto-fit`: com dois cartões numa tela larga, o fit
     esticaria os dois até a borda e cada um ficaria um painel. O fill mantém
     a largura de cartão e alinha à esquerda, no mesmo eixo do título — e a
     fileira vai enchendo à medida que entram matrizes. */
  .cartoes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 340px));
    gap: var(--e-4);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--e-2);
    padding: var(--e-4) var(--e-5) var(--e-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-cartao);
    box-shadow: var(--sombra-1);
    text-decoration: none;
  }
  .card:hover {
    border-color: var(--accent);
    box-shadow: var(--sombra-2);
  }

  .cod {
    display: flex;
    align-items: center;
    gap: var(--e-2);
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: var(--tr-rotulo);
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .selo {
    font-style: normal;
    padding: 1px 6px;
    border-radius: 999px;
    border: 1px solid currentColor;
  }
  .selo.atual {
    color: var(--accent);
  }

  /* o número é o que se compara entre duas matrizes do mesmo curso, então é
     ele que fica no lugar do título */
  .card h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--e-2);
    font-size: var(--t-lg);
    margin: 0;
  }
  .card h3 span {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    font-weight: 400;
    color: var(--ink-3);
  }
  .card p {
    font-size: var(--t-sm);
    margin: 0;
    /* empurra o rodapé do cartão para baixo, alinhando os de uma fileira */
    flex: 1;
  }

  .conta {
    display: flex;
    align-items: baseline;
    gap: var(--e-2);
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--accent);
    padding-top: var(--e-2);
    border-top: 1px solid var(--line);
  }
  .conta em {
    font-style: normal;
    margin-left: auto;
  }
</style>
