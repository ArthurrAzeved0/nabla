/* Índice dos mapas de grade. Existe desde que passou de um curso: até então
   a aba "Grade" no topo apontava direto para Civil, e com dois cursos esse
   atalho passaria a esconder um deles. Cada curso novo é só mais um YAML —
   esta página não muda. */
import { getCollection } from "astro:content";
import Base from "~/layouts/Base.astro";
import Regua from "~/components/Regua.astro";

const base = import.meta.env.BASE_URL;
const cadeiras = await getCollection("cadeiras");
const comPagina = new Set(cadeiras.map((c) => c.data.id));

const grades = (await getCollection("grade"))
  .map((g) => {
    const d = g.data.disciplinas;
    return {
      ...g.data,
      quantas: d.length,
      chMatriz: d.reduce((s, x) => s + x.teorica + x.pratica, 0),
      arestas: d.reduce((s, x) => s + x.pre.length + x.co.length, 0),
      ligadas: d.filter((x) => {
        const id = typeof x.cadeira === "string" ? x.cadeira : x.cadeira?.id;
        return id && comPagina.has(id);
      }).length,
    };
  })
  .sort((a, b) => a.curso.localeCompare(b.curso, "pt-BR"));
---

<Base
  titulo="Mapas da grade"
  descricao="Mapas de pré-requisitos das grades da POLI/UPE: marque o que já concluiu e veja o que está liberado."
>
  <span class="rotulo">POLI/UPE</span>
  <h1>Mapas da grade</h1>
  <p class="prosa abre">
    O mapa de pré-requisitos de cada curso, montado a partir do projeto pedagógico. Marque o que
    você já concluiu e veja o que está liberado para o próximo período — o progresso fica salvo no
    seu navegador, e cada mapa sai em PDF.
  </p>

  <Regua rotulo="cursos" />

  <div class="cartoes">
    {
      grades.map((g) => (
        <a class="card" href={`${base}grade/${g.sigla}/`}>
          <span class="cod">matriz {g.matriz}</span>
          <h2>{g.curso}</h2>
          <p>
            {g.quantas} disciplinas e {g.arestas} requisitos,{" "}
            {g.chMatriz === g.chTotalCurso
              ? `${g.chMatriz}h no total`
              : `${g.chMatriz}h de um curso de ${g.chTotalCurso}h`}
            .{g.ligadas > 0 && ` ${g.ligadas} com teoria e questões aqui no site.`}
          </p>
          <span class="conta">
            Ver o mapa
            <em>{g.quantas} disciplinas</em>
          </span>
        </a>
      ))
    }
  </div>
</Base>

<style>
  .abre {
    font-size: var(--t-md);
  }

  /* mesmo cartão da home: um curso é um cartão, e a grade de cartões é a
     mesma linguagem em todo o site */
  .cartoes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--e-4);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--e-2);
    padding: var(--e-4) var(--e-5) var(--e-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-cartao);
    box-shadow: var(--sombra-1);
    text-decoration: none;
  }
  .card:hover {
    border-color: var(--accent);
    box-shadow: var(--sombra-2);
  }
  .cod {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: var(--tr-rotulo);
    text-transform: uppercase;
    color: var(--accent);
  }
  .card h2 {
    font-size: var(--t-lg);
    margin: 0;
  }
  .card p {
    font-size: var(--t-sm);
    margin: 0;
    flex: 1;
  }
  .conta {
    display: flex;
    align-items: baseline;
    gap: var(--e-2);
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--ink-2);
    padding-top: var(--e-2);
    border-top: 1px solid var(--line);
  }
  .conta em {
    font-style: normal;
    color: var(--ink-3);
    margin-left: auto;
  }
</style>
