/* Índice dos mapas de grade. Existe desde que passou de um curso: até então
   a aba "Grade" no topo apontava direto para Civil, e com dois cursos esse
   atalho passaria a esconder um deles. Cada curso novo é só mais um YAML —
   esta página não muda. */
import { getCollection } from "astro:content";
import Base from "~/layouts/Base.astro";
import Regua from "~/components/Regua.astro";

const base = import.meta.env.BASE_URL;
const cadeiras = await getCollection("cadeiras");
const comPagina = new Set(cadeiras.map((c) => c.data.id));

const todas = await getCollection("grade");

/* Um curso pode ter mais de uma matriz no ar: Automação tem a de 2021 e a de
   2010, que ainda vale para quem entrou até 2020. Quando isso acontece, o
   cartão precisa dizer qual é qual — e a mais nova é a atual, o que se sabe
   ordenando as matrizes do próprio curso, sem campo novo no dado. */
const maisNova = new Map();
for (const g of todas) {
  const atual = maisNova.get(g.data.curso);
  if (!atual || g.data.matriz > atual) maisNova.set(g.data.curso, g.data.matriz);
}
const quantasMatrizes = new Map();
for (const g of todas) {
  quantasMatrizes.set(g.data.curso, (quantasMatrizes.get(g.data.curso) ?? 0) + 1);
}

const grades = todas
  .map((g) => {
    const d = g.data.disciplinas;
    return {
      ...g.data,
      quantas: d.length,
      chMatriz: d.reduce((s, x) => s + x.teorica + x.pratica, 0),
      arestas: d.reduce((s, x) => s + x.pre.length + x.co.length, 0),
      ligadas: d.filter((x) => {
        const id = typeof x.cadeira === "string" ? x.cadeira : x.cadeira?.id;
        return id && comPagina.has(id);
      }).length,
      /* só marca quando há mais de uma: num curso de matriz única o selo
         "atual" não informa nada */
      selo:
        (quantasMatrizes.get(g.data.curso) ?? 0) > 1
          ? g.data.matriz === maisNova.get(g.data.curso)
            ? "atual"
            : "anterior"
          : undefined,
    };
  })
  /* curso em ordem alfabética; dentro do curso, a matriz mais nova primeiro */
  .sort((a, b) => a.curso.localeCompare(b.curso, "pt-BR") || b.matriz.localeCompare(a.matriz));
---

<Base
  titulo="Mapas da grade"
  descricao="Mapas de pré-requisitos das grades da POLI/UPE: marque o que já concluiu e veja o que está liberado."
>
  <span class="rotulo">POLI/UPE</span>
  <h1>Mapas da grade</h1>
  <p class="prosa abre">
    O mapa de pré-requisitos de cada curso, montado a partir do projeto pedagógico. Marque o que
    você já concluiu e veja o que está liberado para o próximo período — o progresso fica salvo no
    seu navegador, e cada mapa sai em PDF.
  </p>

  <Regua rotulo="cursos" />

  <div class="cartoes">
    {
      grades.map((g) => (
        <a class="card" href={`${base}grade/${g.sigla}/`}>
          <span class="cod">
            matriz {g.matriz}
            {g.selo && <i class:list={["selo", g.selo]}>{g.selo}</i>}
          </span>
          <h2>{g.curso}</h2>
          <p>
            {g.quantas} disciplinas e {g.arestas} requisitos,{" "}
            {g.chMatriz === g.chTotalCurso
              ? `${g.chMatriz}h no total`
              : `${g.chMatriz}h de um curso de ${g.chTotalCurso}h`}
            .{g.ligadas > 0 && ` ${g.ligadas} com teoria e questões aqui no site.`}
          </p>
          <span class="conta">
            Ver o mapa
            <em>{g.quantas} disciplinas</em>
          </span>
        </a>
      ))
    }
  </div>
</Base>

<style>
  .abre {
    font-size: var(--t-md);
  }

  /* mesmo cartão da home: um curso é um cartão, e a grade de cartões é a
     mesma linguagem em todo o site */
  .cartoes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--e-4);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--e-2);
    padding: var(--e-4) var(--e-5) var(--e-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-cartao);
    box-shadow: var(--sombra-1);
    text-decoration: none;
  }
  .card:hover {
    border-color: var(--accent);
    box-shadow: var(--sombra-2);
  }
  .cod {
    display: flex;
    align-items: center;
    gap: var(--e-2);
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: var(--tr-rotulo);
    text-transform: uppercase;
    color: var(--accent);
  }
  /* etiqueta do selo: a atual em destaque, a anterior apagada — a diferença
     entre as duas é o que o leitor está procurando neste cartão */
  .selo {
    font-style: normal;
    padding: 1px 6px;
    border-radius: 999px;
    border: 1px solid currentColor;
  }
  .selo.anterior {
    color: var(--ink-3);
  }
  .card h2 {
    font-size: var(--t-lg);
    margin: 0;
  }
  .card p {
    font-size: var(--t-sm);
    margin: 0;
    flex: 1;
  }
  .conta {
    display: flex;
    align-items: baseline;
    gap: var(--e-2);
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--ink-2);
    padding-top: var(--e-2);
    border-top: 1px solid var(--line);
  }
  .conta em {
    font-style: normal;
    color: var(--ink-3);
    margin-left: auto;
  }
</style>
