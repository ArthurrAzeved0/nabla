/* Mapa da grade de um curso. Uma rota por arquivo em src/content/grade —
   Civil e Controle e Automação hoje. Curso novo não exige código novo: só
   mais um YAML, e ele aparece aqui e no índice em /grade/. */
import { getCollection } from "astro:content";
import Base from "~/layouts/Base.astro";
import MapaGrade from "~/components/MapaGrade.astro";
import Regua from "~/components/Regua.astro";

export async function getStaticPaths() {
  const grades = await getCollection("grade");
  const cadeiras = await getCollection("cadeiras");
  const comPagina = new Set(cadeiras.map((c) => c.data.id));
  return grades.map((g) => ({
    params: { curso: g.data.sigla },
    props: {
      grade: g,
      comPagina,
      /* As outras matrizes DO MESMO curso. Automação tem duas no ar, e quem
         cai na errada precisa de uma porta para a outra — sem ter de voltar
         ao índice para descobrir que ela existe. */
      irmas: grades
        .filter((o) => o.data.curso === g.data.curso && o.data.sigla !== g.data.sigla)
        .map((o) => ({ sigla: o.data.sigla, matriz: o.data.matriz }))
        .sort((a, b) => b.matriz.localeCompare(a.matriz)),
    },
  }));
}

const { grade, comPagina, irmas } = Astro.props;
const g = grade.data;
const base = import.meta.env.BASE_URL;

const chMatriz = g.disciplinas.reduce((s, d) => s + d.teorica + d.pratica, 0);
/* Em Automação a matriz cobre a CH inteira do curso — eletivas e atividades
   complementares inclusive. Em Civil ela não cobre, e aí a comparação entre
   as duas cargas informa algo. Quando são iguais, dizer "3600h de um curso
   de 3600h" só faz o leitor reler a frase. */
const chIgual = chMatriz === g.chTotalCurso;
const ligadas = g.disciplinas.filter((d) => {
  const id = typeof d.cadeira === "string" ? d.cadeira : d.cadeira?.id;
  return id && comPagina.has(id);
}).length;
---

<Base
  largura="ampla"
  titulo={`Grade · ${g.curso}`}
  descricao={`Mapa de pré-requisitos de ${g.curso} na POLI/UPE, matriz ${g.matriz}. Marque o que já concluiu e veja o que está liberado.`}
>
  <span class="rotulo">POLI/UPE · matriz {g.matriz}</span>
  <h1>{g.curso}</h1>
  <p class="prosa abre">
    Mapa de pré-requisitos das <strong>{g.disciplinas.length} disciplinas</strong> da matriz
    ({chIgual ? `${chMatriz}h, a carga horária inteira do curso` : `${chMatriz}h de um curso de ${g.chTotalCurso}h`}).
    Marque o que já concluiu para ver o que está liberado — o progresso fica salvo neste
    navegador.
    {
      ligadas > 0 && (
        <>
          {" "}
          <strong>{ligadas} cadeiras</strong> já têm teoria e questões aqui no site.
        </>
      )
    }
  </p>

  {
    /* A observação diz a quem esta matriz se aplica; é opcional, porque num
       curso de matriz única não há o que esclarecer. O link para a matriz irmã
       aparece independente dela: quem cai no perfil errado precisa de uma
       porta para o outro, e nem toda grade tem observação escrita. */
    (g.observacao || irmas.length > 0) && (
      <p class="aviso">
        {g.observacao}
        {irmas.map((o) => (
          <>
            {g.observacao ? " " : ""}
            <a href={`${base}grade/${o.sigla}/`}>Ver a matriz {o.matriz} deste curso</a>.
          </>
        ))}
      </p>
    )
  }

  <Regua rotulo="mapa" />

  <MapaGrade grade={grade} comPagina={comPagina} />
</Base>

<script>
  import { ligarGrade } from "~/ilhas/grade-ui";
  ligarGrade();
</script>

<style>
  .abre {
    font-size: var(--t-md);
  }
  /* Nota discreta, não alarme: informa de quem é a matriz, sem competir com o
     título nem com o mapa. Barra à esquerda em vez de caixa colorida. */
  .aviso {
    max-width: var(--largura-texto);
    margin: calc(-1 * var(--e-3)) 0 var(--e-5);
    padding-left: var(--e-3);
    border-left: 2px solid var(--accent);
    font-size: var(--t-sm);
    color: var(--ink-2);
  }
  /* o cabeçalho acompanha a largura da página, mas o texto não: título e
     parágrafo alinham à esquerda com o mapa, e a linha para em 68ch */
  h1 {
    max-width: var(--largura-texto);
  }
</style>
