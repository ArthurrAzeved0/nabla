/* Sumário do conteúdo, montado a partir do frontmatter da teoria.

   No site 1.x o sumário era HTML escrito à mão, ao lado das seções — duas
   listas para manter em sincronia. Agora é dado, e há uma verificação de
   build que garante que todo item aponta para uma seção existente. */
interface Secao {
  id: string;
  titulo: string;
}
interface Unidade {
  nome: string;
  prova?: "1ee" | "2ee" | "nao-caiu";
  secoes: Secao[];
}

/* Rótulo e explicação de cada marcação. O texto do `title` guarda de onde a
   informação vem — é o que impede que ela seja lida como opinião. */
const ETIQUETA = {
  "1ee": ["1º EE", "Assunto do 1º Exercício Escolar: é o que os quesitos das provas de 1º EE do acervo cobram."],
  "2ee": ["2º EE", "Assunto do 2º Exercício Escolar: é o que os quesitos das provas de 2º EE do acervo cobram."],
  "nao-caiu": ["não caiu", "Está na ementa, mas não aparece em nenhuma prova, 2ª chamada ou final do acervo (2014–2026), nem no capítulo 5 da apostila."],
} as const;
interface Props {
  unidades: Unidade[];
}

const { unidades } = Astro.props;
---

<nav class="sumario" aria-label="Sumário do conteúdo">
  {
    unidades.map((u) => (
      <div class="unidade">
        <h2>
          {u.nome}
          {u.prova && (
            <span class="ee" data-ee={u.prova} title={ETIQUETA[u.prova][1]}>
              {ETIQUETA[u.prova][0]}
            </span>
          )}
        </h2>
        <ol>
          {u.secoes.map((s) => (
            <li>
              <a href={`#${s.id}`}>{s.titulo}</a>
            </li>
          ))}
        </ol>
      </div>
    ))
  }
</nav>

<style>
  .sumario {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--e-5);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-caixa);
    padding: var(--e-5);
    margin: var(--e-5) 0 var(--e-7);
  }
  h2 {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--e-2);
    font-size: var(--t-sm);
    font-family: var(--f-mono);
    font-weight: 500;
    letter-spacing: var(--tr-rotulo);
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 var(--e-3);
  }
  /* a etiqueta de avaliação: mesma pastilha dos chips de prova */
  .ee {
    flex: none;
    font-size: var(--t-xs);
    letter-spacing: var(--tr-rotulo);
    border-radius: var(--r-pilula);
    padding: 1px 7px;
    background: var(--accent-soft);
    color: var(--accent);
    cursor: help;
  }
  .ee[data-ee="nao-caiu"] {
    background: var(--surface-2);
    color: var(--ink-3);
    border: 1px solid var(--line);
  }
  ol {
    margin: 0;
    padding-left: var(--e-5);
    font-size: var(--t-sm);
  }
  li {
    margin-bottom: var(--e-2);
  }
  li::marker {
    font-family: var(--f-mono);
    color: var(--ink-3);
  }
  a {
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
