/* Duas figuras lado a lado — usado quando o par só faz sentido junto
   (perfil + vista de cima, antes + depois). Empilha no celular. */
---
<div class="fig-par"><slot /></div>

<style>
  .fig-par {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-4);
    margin: var(--e-4) 0;
  }
  @media (max-width: 640px) {
    .fig-par {
      grid-template-columns: 1fr;
    }
  }
  .fig-par :global(figure) {
    margin: 0;
  }
</style>
