/* Etiqueta (pílula) usada no topo das questões: prova, tema, pontuação.
     info   -> identidade (prova, tema)
     alerta -> chama atenção ("Estilo de prova")
     neutra -> dado seco (pontuação) */
interface Props {
  tom?: "info" | "alerta" | "neutra";
}

const { tom = "info" } = Astro.props;
---

<span class:list={["etiqueta", tom]}><slot /></span>

<style>
  .etiqueta {
    display: inline-block;
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    line-height: 1.5;
    padding: 3px 9px;
    border-radius: var(--r-pilula);
    white-space: nowrap;
  }
  .info {
    background: var(--accent-soft);
    color: var(--accent);
  }
  .alerta {
    background: var(--action-soft);
    color: var(--action);
  }
  .neutra {
    background: var(--surface-2);
    color: var(--ink-3);
    border: 1px solid var(--line);
  }
</style>
