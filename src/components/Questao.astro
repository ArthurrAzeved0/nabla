/* Cartão de questão — o "registro de trabalho" do Nabla.
   Na Fase 1 é só a casca visual: as ferramentas (marcar, cronometrar,
   filtrar) viram uma ilha interativa na Fase 3. Os botões aqui são
   estáticos de propósito.

   O `estado` pinta a barra lateral com a cor semântica, para dar para ler
   a situação da questão sem interpretar nada. */
import Etiqueta from "./Etiqueta.astro";

interface Props {
  /** Igual ao data-id do site 1.x: <curso>-<prova>-<NN>. Vira a âncora. */
  id: string;
  numero: number;
  /** Rótulo da avaliação, DERIVADO da pasta — nunca digitado por questão.
      É o que garante que "1º EE" não vire "1ª Avaliação" em algum arquivo. */
  prova: string;
  /** Procedência: "2023.2", "Banco", "Revisão · Prof. César". Ausente nas
      questões inventadas (que se identificam por estiloDeProva). */
  origem?: string;
  tema: string;
  pontos?: string;
  /** Questão inventada/prevista, sem prova antiga confirmada. */
  estiloDeProva?: boolean;
  /** Link para a seção da teoria correspondente. */
  material?: string;
  /** Marcação do aluno. A interação vem na Fase 3; aqui só pinta a barra. */
  estado?: "nenhum" | "acertei" | "errei" | "revisar";
}

const {
  id,
  numero,
  prova,
  origem,
  tema,
  pontos,
  estiloDeProva = false,
  material,
  estado = "nenhum",
} = Astro.props;

const rotulo = String(numero).padStart(2, "0");
---

<article class:list={["questao", `st-${estado}`]} id={id}>
  <div class="topo">
    <a class="qid" href={`#${id}`} title="Link direto para esta questão">Questão {rotulo}</a>
    <Etiqueta>{prova}</Etiqueta>
    {origem && <Etiqueta tom="neutra" titulo="Procedência">{origem}</Etiqueta>}
    <Etiqueta>{tema}</Etiqueta>
    {estiloDeProva && <Etiqueta tom="alerta">Estilo de prova</Etiqueta>}
    {pontos && <Etiqueta tom="neutra">{pontos}</Etiqueta>}
    {
      material && (
        <a class="material" href={material}>
          <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" focusable="false">
            <path
              d="M5 4h9l4 4v12H5z"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"></path>
            <path
              d="M13 4v5h5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linejoin="round"></path>
          </svg>
          Ver material
        </a>
      )
    }
  </div>

  <div class="enunciado"><slot /></div>

</article>

<style>
  .questao {
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--line);
    border-radius: var(--r-cartao);
    padding: var(--e-4) var(--e-5);
    margin: var(--e-4) 0;
    box-shadow: var(--sombra-1);
    scroll-margin-top: var(--e-7);
  }

  .st-acertei {
    border-left-color: var(--ok);
  }
  .st-errei {
    border-left-color: var(--err);
  }
  .st-revisar {
    border-left-color: var(--rev);
  }

  .topo {
    display: flex;
    align-items: center;
    gap: var(--e-2);
    flex-wrap: wrap;
    margin-bottom: var(--e-3);
  }

  .qid {
    font-family: var(--f-mono);
    font-size: var(--t-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink);
    text-decoration: none;
  }
  .qid:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .material {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--t-sm);
    color: var(--accent);
    text-decoration: none;
    background: var(--accent-soft);
    border: 1px solid transparent;
    padding: 4px 10px;
    border-radius: var(--r-pilula);
  }
  .material:hover {
    border-color: var(--accent);
  }

  .enunciado {
    color: var(--ink);
  }
  .enunciado :global(> :last-child) {
    margin-bottom: 0;
  }

  

  
  
  
  
  
  

  
</style>
